# Project exclude paths
/.gradle/
/build/

# ---- خروجی‌های ساخت، در **هر** ماژول ----
#
# خطِ `/build/` بالا فقط ریشه را می‌گیرد (اسلشِ ابتدایی یعنی همین‌جا).
# ماژول‌ها زیرشاخه‌اند و بی این خط‌ها `app/build`، `core/build` و
# `desktop/build` وارد گیت می‌شدند — امروز روی این ماشین ۵۷۰ مگابایت،
# با یک JVMِ کامل و ۴۹ jar داخلش.
build/
.gradle/
.kotlin/
.cxx/
captures/

# حافظهٔ پنهانِ پایتون — بررسی‌ها با اجرا شدن می‌سازندش.
#
# سه تای این‌ها با نسخهٔ ۳.۱۱ ساخته شده بودند و در همان نسخهٔ اول وارد
# گیت شدند. بایت‌کدِ کامپایل‌شده به نسخهٔ مفسر گره خورده و هر کسی با
# پایتونِ دیگری فایلِ تازه می‌سازد — یعنی diffهایی که هیچ‌کس ننوشته.
__pycache__/
*.pyc

# تنظیماتِ محیطِ توسعه — مالِ این کامپیوتر است، نه پروژه
.idea/
*.iml
*.hprof
# ---- چیزهایی که هرگز نباید در گیت بنشینند ----
# کلیدِ امضا: اگر به GitHub برود، هر کسی می‌تواند به‌جای شما آپدیت
# بسازد و روی اپِ کارگاه بنشاند. Android Studio پیش‌فرض کلید را داخل
# همین پوشه می‌سازد، پس این قاعده‌ها لازم‌اند.
*.jks
*.keystore
keystore.properties
signing.properties

# همان قاعده برای امضای ویندوز. `.pfx` کلیدِ خصوصیِ امضای کد است و
# اگر بیرون برود، هر کسی می‌تواند بدافزاری بسازد که به نامِ شما امضا
# شده — و روی هر کمپیوتری که گواهیِ شما را نصب کرده، **مورد اعتماد**
# باز می‌شود. `.cer` عمومی است و ضرری ندارد، ولی جایش هم اینجا نیست.
*.pfx
*.cer
*.crt

# و همان قاعده برای امضای مک. گواهیِ Developer ID با کلیدِ خصوصی‌اش
# به‌صورتِ `.p12` بیرون داده می‌شود (که پایین‌تر مسدود است) و
# `.provisionprofile` / `.mobileprovision` پروفایل‌های اپل‌اند.
#
# `*.p8` مهم‌تر از آن است که به نظر می‌آید: کلیدِ App Store Connect API
# است و **یک بار بیشتر دانلود نمی‌شود**. با آن می‌شود به نامِ شما
# notarize کرد و در حساب دست برد.
*.provisionprofile
*.mobileprovision
*.p8

# مسیرِ SDK روی کامپیوترِ شخصی — روی هیچ ماشینِ دیگری درست نیست
local.properties

# متغیرهای محیطی و رمز
.env
.env.*

# رمزِ برنامهٔ وردپرس — با همان قاعدهٔ کلیدِ امضا: هرگز کنارِ کد
wp-credentials.json
*.p12
*.pem
